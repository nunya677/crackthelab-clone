{
  "name": "crackthelab-clone",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace=packages/shared",
    "dev": "npm run dev --workspace=apps/api & npm run dev --workspace=apps/web & npm run dev --workspace=apps/orchestrator",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=infra",
    "db:seed": "npm run db:seed --workspace=infra",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
