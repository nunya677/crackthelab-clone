{
  "name": "crackthelab-clone",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/api & npm run dev --workspace=apps/web & npm run dev --workspace=apps/orchestrator",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=infra",
    "db:seed": "npm run db:seed --workspace=infra",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "cpu-features@0.0.10": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@6.19.3": true,
    "protobufjs@7.6.5": true,
    "ssh2@1.17.0": true
  }
}
