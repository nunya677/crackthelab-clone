# Production env for docker-compose.prod.yml, on the VM.
# Copy to .env.production and fill in real values — never commit the filled
# version. Generate secrets with: openssl rand -hex 32

# Postgres (compose builds DATABASE_URL from these; don't set it directly)
POSTGRES_USER=crackthelab
POSTGRES_PASSWORD="change-me-strong-password"
POSTGRES_DB=crackthelab

# Auth
JWT_ACCESS_SECRET="change-me-generate-with-openssl-rand-hex-32"
JWT_REFRESH_SECRET="change-me-generate-a-different-one"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# The deployed frontend's real origin (Vercel/Cloudflare Pages URL or your
# own domain). Must be exact — CORS will reject anything else.
WEB_ORIGIN="https://exploityard.vercel.app"

# Internal auth between api <-> orchestrator (they're on the same private
# Docker network, but this stops anything else on that network from calling
# the orchestrator directly).
ORCHESTRATOR_INTERNAL_TOKEN="change-me-generate-with-openssl-rand-hex-32"

# The VM's public IP or domain — this is what gets embedded in every live
# challenge's instance URL, so players' browsers can actually reach it.
# Using "localhost" here (the old default) would point every instance URL
# back at the server itself instead of the internet.
PUBLIC_HOST="203.0.113.10"

# Live-instance resource limits (same meaning as local dev)
INSTANCE_TTL_MINUTES=45
INSTANCE_MEMORY_MB=256
INSTANCE_CPU_QUOTA=0.5
INSTANCE_PIDS_LIMIT=64
MAX_LIVE_INSTANCES_PER_USER=1
PRO_INSTANCE_MULTIPLIER=3

# Billing (PayPal) — use live (not sandbox) credentials once you're ready to
# actually charge. See UpgradePage.tsx / billing.ts for how these are used.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_API_BASE="https://api-m.paypal.com"
PAYPAL_WEBHOOK_ID=""
