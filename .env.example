# Postgres
DATABASE_URL="postgresql://crackthelab:crackthelab@localhost:5432/crackthelab"

# Redis (BullMQ job queue)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# apps/api
API_PORT=4000
WEB_ORIGIN="http://localhost:5173"
# Comma-separated extra CORS origins, e.g. an ngrok tunnel URL for testing on
# a phone. Leave empty for normal local dev.
EXTRA_CORS_ORIGINS=""
ORCHESTRATOR_URL="http://localhost:4100"
ORCHESTRATOR_INTERNAL_TOKEN="change-me-internal-token"

# apps/orchestrator
ORCHESTRATOR_PORT=4100
DOCKER_SOCKET="//./pipe/docker_engine"
INSTANCE_TTL_MINUTES=45
INSTANCE_MEMORY_MB=256
INSTANCE_CPU_QUOTA=0.5
INSTANCE_PIDS_LIMIT=64
MAX_LIVE_INSTANCES_PER_USER=1
PRO_INSTANCE_MULTIPLIER=3

# Billing (PayPal) — get these from developer.paypal.com; sandbox by default.
# The subscription plan itself (price, billing interval) is configured on
# PayPal's side, not here — VITE_PAYPAL_PLAN_ID below points at it.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
PAYPAL_WEBHOOK_ID=""

# apps/web
VITE_API_URL="http://localhost:4000"
VITE_PAYPAL_CLIENT_ID=""
VITE_PAYPAL_PLAN_ID=""
